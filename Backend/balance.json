  "attacks": [
    {
      "name": "Валютная атака",
      "base_cost": 120,
      "base_damage": 12,
      "base_risk": 10,
      "attack_type": "currency_crisis",
      "tooltip": "Ты обрушиваешь курс национальной валюты через массовую скупку или сброс гособлигаций. Атака эффективна против стран с большим долгом или скудными золотовалютными резервами, у них просто нет защиты для своей валюты. Именно поэтому международные организации требуют от стран держать резервы. Члены G7 получают поддержку МВФ, так что против них атака слабее.",
      "multipliers": {
        "high_debt_low_reserves": 1.65,
        "high_debt": 1.5,
        "low_reserves": 1.3,
        "low_debt_high_reserves": 0.4,
        "conditions": {
          "debt_gdp_threshold": 80,
          "reserves_threshold": 200
        }
      }
    },
    {
      "name": "Долговая спираль",
      "base_cost": 160,
      "base_damage": 16,
      "base_risk": 8,
      "attack_type": "debt_spiral",
      "tooltip": "Ты провоцируешь рост процентных ставок по государственному долгу. Страна начинает платить по кредитам всё больше, а выбраться из ямы не может. Атака смертельна для стран, чей долг превышает размер всей их экономики, кредиторы просто перестают верить, что им отдадут. Если долг низкий, рынки спокойны, и атака почти не работает. Члены G7 могут получить экстренные кредиты МВФ, которые сбивают ставки.",
      "multipliers": {
        "critical_debt": 1.25,
        "high_debt": 1.2,
        "low_debt": 0.3,
        "conditions": {
          "critical_threshold": 100,
          "high_threshold": 80
        }
      }
    },
    {
      "name": "Торговые санкции",
      "base_cost": 150,
      "base_damage": 14,
      "base_risk": 9,
      "attack_type": "trade_blockade",
      "tooltip": "Ты отрезаешь страну от её главных рынков. Атака эффективна, если у страны один два ключевых торговых партнёра, на которых завязан весь экспорт. Товары некуда девать, экономика задыхается. Если же у страны много равнозначных партнёров, она легко перенаправит потоки. Члены ЕС и БРИКС торгуют внутри своих блоков, поэтому санкции им страшны меньше.",
      "multipliers": {
        "high_dependency": 1.1,
        "concentrated_partners": 1.3,
        "low_dependency": 0.4,
        "conditions": {
          "trade_dependency_threshold": 50
        }
      }
    },
    {
      "name": "Энергетический шантаж",
      "base_cost": 180,
      "base_damage": 18,
      "base_risk": 14,
      "attack_type": "energy_embargo",
      "tooltip": "Ты перекрываешь поставки газа, нефти или угля. Атака сокрушительна для стран импортёров, которые сильно зависят от чужой энергии, остановка поставок парализует заводы. Но она совершенно бесполезна против стран экспортёров, у которых своих ресурсов в избытке. В Европейском Союзе есть правило: если одна страна остаётся без энергии, соседи делятся запасами, это сбивает силу удара.",
